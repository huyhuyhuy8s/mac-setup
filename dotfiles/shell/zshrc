# ~/.zshrc  (macOS default shell)

# MacPorts. Intel macOS uses the /opt/local prefix; no shellenv step needed.
if [ -d /opt/local/bin ]; then
  export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
fi

# Toolchain paths (mirrors the Linux machine)
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
# Ruby user gems. Adjust the ruby version dir if the macOS ruby differs
# (check with: gem env gemdir).
export PATH="$HOME/.local/share/gem/ruby/3.4.0/bin:$PATH"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

alias mux='tmuxinator'

# Adds ~/.local/bin to PATH
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Prompt
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# --- Secrets: macOS Keychain first, then ~/.secrets/<service> ---------------
# Create Keychain items with the commands in SECRETS.md.
keychain_read() {
  local service="$1" val=""
  val="$(/usr/bin/security find-generic-password -a "${USER:?}" -s "$service" -w 2>/dev/null)" || true
  if [ -n "$val" ]; then
    printf '%s' "$val"
    return 0
  fi
  if [ -f "$HOME/.secrets/$service" ]; then
    tr -d '\n' < "$HOME/.secrets/$service"
    return 0
  fi
  return 1
}

if _or_key="$(keychain_read openrouter-key)"; then
  export OPENROUTER_API_KEY="$_or_key"
  unset _or_key
fi
if _c7_key="$(keychain_read context7-key)"; then
  export CONTEXT7_API_KEY="$_c7_key"
  unset _c7_key
fi

export PIG_HOME="$HOME/.config/pig"
